# Flask
FLASK_SECRET_KEY=замените_на_случайную_строку_минимум_32_символа
FLASK_DEBUG=1

# База данных
# Оставьте пустым для SQLite (рекомендуется для локальной разработки).
# Для PostgreSQL: postgresql://user:password@localhost:5432/fanfic_app
DATABASE_URL=

# TMDB (The Movie Database) — https://www.themoviedb.org/settings/api
# Зарегистрируйтесь и создайте API-ключ (бесплатно, тип: Developer).
TMDB_API_KEY=ваш_ключ_tmdb

# Mistral AI — https://console.mistral.ai/api-keys
# Создайте ключ в разделе API Keys.
MISTRAL_API_KEY=ваш_ключ_mistral
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Google OAuth — https://console.cloud.google.com/
# 1. Создайте проект → APIs & Services → Credentials → OAuth 2.0 Client ID.
# 2. Тип: Web application.
# 3. Добавьте Authorized redirect URI: http://127.0.0.1:5000/google_callback
# Если не нужен Google OAuth — оставьте пустым, кнопка просто не будет работать.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/google_callback
